{
  "functions": {
    "api/index.py": {
      "includeFiles": "{templates/**,static/**,api/static/**,project.py}"
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/api/index/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
